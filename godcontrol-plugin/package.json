{
  "name": "godcontrol-public-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public OAuth-protected MCP hub and outbound GodControl agent",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "start": "node hub/server.js",
    "agent": "node agent/main.js",
    "test": "node --test test/*.test.js",
    "check": "node --check hub/server.js && node --check agent/main.js && node --check shared/*.js",
    "build": "npm run check",
    "lint": "npm run check",
    "smoke": "node scripts/smoke-test.js",
    "doctor": "bash scripts/doctor.sh",
    "create-user": "node scripts/create-user.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  }
}
