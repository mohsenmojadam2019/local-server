NODE_ENV=development
PORT=19091
PUBLIC_BASE_URL=https://mcp.example.com
OAUTH_ISSUER=https://mcp.example.com
OAUTH_RESOURCE=https://mcp.example.com/mcp
DATABASE_URL=
SESSION_SECRET=replace-with-at-least-32-random-bytes
CHALLENGE_TOKEN_FILE=
ALLOW_SIGNUP=false
AGENT_ENROLLMENT_TTL_SECONDS=600
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
MAX_RESULT_BYTES=120000
LOCAL_MCP_URL=http://127.0.0.1:8787/mcp
LOCAL_BEARER_TOKEN=
AGENT_CONFIG_FILE=/etc/godcontrol-agent/config.json
ALLOWED_ORIGINS=
