NODE_ENV=production
OIDC_HOST=127.0.0.1
OIDC_PORT=19092
OIDC_ISSUER=https://auth.example.com
GODCONTROL_MCP_RESOURCE=https://mcp.example.com
GODCONTROL_REDIS_URL=redis://:replace-password@127.0.0.1:16379/0
OIDC_JWKS_PATH=/etc/godcontrol/oidc-jwks.json
OIDC_COOKIE_KEYS=replace-key-1,replace-key-2
OIDC_FORM_SECRET=replace-with-at-least-32-random-characters
