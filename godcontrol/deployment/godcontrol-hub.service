[Unit]
Description=GodControl MCP Hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=godcontrol
Group=godcontrol
WorkingDirectory=/opt/local-server/godcontrol
EnvironmentFile=/etc/godcontrol/hub.env
ExecStart=/usr/bin/node hub/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/godcontrol

[Install]
WantedBy=multi-user.target
