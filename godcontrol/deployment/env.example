NODE_ENV=production
HOST=127.0.0.1
PORT=8790
PUBLIC_ORIGIN=https://mcp.example.com

OIDC_ISSUER=https://auth.example.com
OIDC_JWKS_URI=https://auth.example.com/.well-known/jwks.json
OIDC_AUDIENCE=https://mcp.example.com

GODCONTROL_DEVICE_HMAC_SECRET=replace-with-a-long-random-secret
GODCONTROL_CALL_TIMEOUT_MS=30000
GODCONTROL_AUDIT_FILE=/var/log/godcontrol/audit.jsonl
OPENAI_APPS_CHALLENGE=

# Agent-only values, configured on each device:
# GODCONTROL_HUB_WS=wss://mcp.example.com/agent
# GODCONTROL_DEVICE_TOKEN=
# GODCONTROL_LOCAL_MCP=http://127.0.0.1:8787/mcp
# GODCONTROL_LOCAL_TOKEN=
# GODCONTROL_READ_ROOTS=/home/user/projects
# GODCONTROL_WRITE_ROOTS=/home/user/projects
# GODCONTROL_ALLOWED_PROGRAMS=git
# GODCONTROL_PROCESS_ENV_ALLOWLIST=PATH,HOME,LANG,TERM,USER
# GODCONTROL_PROCESS_TIMEOUT_MS=120000
